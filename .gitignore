# Supabase CLI: lokaler Projekt-Link, enthaelt u. a. pooler-url MIT DB-Passwort
supabase/.temp/

# Capacitor: native Build-Artefakte (Projekte selbst werden getrackt)
ios/App/Pods/
ios/App/App/public/
android/app/src/main/assets/public/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.keystore
# Android-Signierung: der Release-Workflow schreibt beide Dateien in den
# Arbeitsordner und loescht sie danach. Wer lokal einmal ein Release baut,
# haette sie sonst im naechsten Commit — und der Upload-Schluessel ist
# unersetzlich: geht er verloren, laesst sich die App nie wieder aktualisieren.
*.jks
android/keystore.properties
.vercel

# Claude Code: persoenliche Einstellungen (nicht teilen)
.claude/settings.local.json

# Vom Icon-Werkzeug erzeugte Zwischenstaende — nur im Wurzelordner.
# Ohne den fuehrenden Schraegstrich traf die Regel auch src/assets/, und die
# Strohhalm-Bilder waeren still nicht ins Repo gekommen (Build bei Cloudflare rot).
/assets/
.screenshots/
# Store-Bilder aus tools/store-bilder.mjs — Erzeugnisse, keine Quellen.
# Sie entstehen in Sekunden neu und waeren als PNG-Paar von 1290x2796 der
# groesste Posten im ganzen Repo.
.store/
