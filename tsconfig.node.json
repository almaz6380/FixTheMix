{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Anders als in anigosha stehen die Testskripte hier MIT drin: die
     Engine-Tests sind die einzige Absicherung dieser Phase, sie sollen
     bei `npm run build` mitgeprueft werden. */
  "include": ["vite.config.ts", "capacitor.config.ts", "tools/**/*.mts"]
}
